+func (o *OpenVPN) pushedNameServers(addrs []netip.Addr) []dns.NameServer {
+	servers := make([]string, 0, len(addrs))
+	for _, addr := range addrs {
+		servers = append(servers, addr.String())
+	}
+	if len(servers) == 0 {
+		return nil
+	}
+	nss, err := dns.ParseNameServer(servers)
+	if err != nil {
+		log.Warnln("[OpenVPN](%s) ignoring the DNS servers pushed by the server: %v", o.name, err)
+		return nil
+	}
+	return nss
+}
