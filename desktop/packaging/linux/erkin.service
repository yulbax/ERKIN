[Unit]
Description=ERKIN VPN service
Requires=erkin.socket
After=erkin.socket network-online.target
Wants=network-online.target

[Service]
ExecStartPre=-modprobe -a inet_diag tcp_diag udp_diag
ExecStart=/opt/erkin/lib/app/resources/erkin-service run
Restart=on-failure
RestartSec=5
StateDirectory=erkin
StateDirectoryMode=0755
